# Copie este arquivo para .env e preencha. O .env NÃO é versionado.
# Mudou o .env? Recarregue o app por completo: os valores são inlinados no bundle.
# Tudo aqui é público por natureza. Nunca coloque a secret key nem a service_role.

# Ambiente do app: development | preview | production
EXPO_PUBLIC_APP_ENV=

# URL do projeto Supabase (https://<projeto>.supabase.co), em Connect ou Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (começa com sb_publishable_), no mesmo lugar da URL
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
